            "url": {
              "raw": "{{baseUrl}}/services/bank/transfer?fromAccountId={{fromAccountId}}&toAccountId={{toAccountId}}&amount=5.00",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "bank",
                "transfer"
              ],
              "query": [
                {
                  "key": "fromAccountId",
                  "value": "{{fromAccountId}}"
                },
                {
                  "key": "toAccountId",
                  "value": "{{toAccountId}}"
                },
                {
                  "key": "amount",
                  "value": "5.00"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('toAccountId')) { console.warn('skipped: no second account'); pm.execution.skipRequest(); }",
                  "",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/services/bank/accounts/' + pm.environment.get('fromAccountId'),",
                  "                  header: { Accept: 'application/json' } }, (err, res) => {",
                  "    if (!err && res.code === 200) pm.environment.set('balBefore', String(res.json().balance));",
                  "});",
                  "",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/services/bank/accounts/' + pm.environment.get('toAccountId'),",
                  "                  header: { Accept: 'application/json' } }, (err, res) => {",
                  "    if (!err && res.code === 200) pm.environment.set('balToBefore', String(res.json().balance));",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "let body; try { body = pm.response.json(); } catch (e) { body = null; }",
                  "pm.test('Confirmation message', () => pm.expect(pm.response.text()).to.match(/Successfully transferred \\$5/));",
                  "",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/services/bank/accounts/' + pm.environment.get('fromAccountId'),",
                  "                  header: { Accept: 'application/json' } }, (err, res) => {",
                  "    pm.test('Source balance decreased by 5.00', () => {",
                  "        pm.expect(err).to.be.null;",
                  "        const before = Number(pm.environment.get('balBefore'));",
                  "        const after = res.json().balance;",
                  "        pm.expect(Math.round((after - before) * 100) / 100).to.eql(-5);",
                  "    });",
                  "});",
                  "",
                  "pm.sendRequest({ url: pm.environment.get('baseUrl') + '/services/bank/accounts/' + pm.environment.get('toAccountId'),",
                  "                  header: { Accept: 'application/json' } }, (err, res) => {",
                  "    pm.test('Destination balance increased by 5.00', () => {",
                  "        pm.expect(err).to.be.null;",
                  "        const before = Number(pm.environment.get('balToBefore'));",
                  "        const after = res.json().balance;",
                  "        pm.expect(Math.round((after - before) * 100) / 100).to.eql(5);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
