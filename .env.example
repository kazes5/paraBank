# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Use a password created ONLY for this test account: ParaBank's login API
# sends it in the URL path, so it ends up in server/CDN logs.

BASE_URL=https://parabank.parasoft.com/parabank
WEB_UI_URL=https://parabank.parasoft.com/parabank/index.htm

# Test user - registered or verified by ./run.sh setup
PARABANK_USERNAME=
PARABANK_PASSWORD=
PARABANK_SSN=
PARABANK_FIRST_NAME=
PARABANK_LAST_NAME=
PARABANK_STREET=
PARABANK_CITY=
PARABANK_STATE=
PARABANK_ZIP=
PARABANK_PHONE=

# Optional - the login test checks the returned id against this if set
CUSTOMER_ID=
